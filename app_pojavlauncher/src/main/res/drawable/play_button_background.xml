<?xml version="1.0" encoding="utf-8"?>
<!-- Modern gradient play button with rounded corners and a distinct pressed state. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/accent_green_pressed"
                android:endColor="#1F6D15" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_menu_card" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/accent_green_start"
                android:endColor="@color/accent_green_end" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</selector>